# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. All variables are prefixed MPV_.
# ---------------------------------------------------------------------------

# --- Database (async SQLAlchemy URL) --------------------------------------
# In docker-compose the host is the service name `db`. For a local run use localhost.
MPV_DATABASE_URL=postgresql://postgres:TSI@localhost:5432/MCP

# --- HTTP transport --------------------------------------------------------
MPV_HOST=0.0.0.0
MPV_PORT=8000
MPV_MCP_PATH=/mcp
# Canonical, externally reachable base URL of THIS server. Used for the
# OAuth Protected-Resource metadata (RFC 9728) and token audience checks.
MPV_RESOURCE_SERVER_URL=http://localhost:8000
# Optional: the authorization system that issues tokens (shown in discovery
# metadata). Leave blank if tokens are minted purely out-of-band by this app.
MPV_AUTHORIZATION_SERVER_URL=

# --- Auth mode -------------------------------------------------------------
# "jwt"    : the server issues + verifies signed JWTs (per-user, RBAC via scopes).
# "opaque" : the server issues + verifies opaque permanent keys (DB lookup).
MPV_AUTH_MODE=jwt

# --- JWT (when MPV_AUTH_MODE=jwt) ------------------------------------------
MPV_JWT_ALGORITHM=RS256
MPV_JWT_ISSUER=mcp-prompt-validator
# Audience = this server's canonical URL; defaults to MPV_RESOURCE_SERVER_URL.
MPV_JWT_AUDIENCE=http://localhost:8000
# Where an auto-generated RS256 keypair is stored/reused (dev). Mount real keys in prod.
MPV_JWT_KEYS_DIR=./keys
MPV_JWT_AUTO_GENERATE_KEYS=true
# For RS256, provide keys explicitly instead of auto-generating (paths or inline PEM):
MPV_JWT_PRIVATE_KEY_PATH=
MPV_JWT_PUBLIC_KEY_PATH=
# For HS256 instead of RS256: set MPV_JWT_ALGORITHM=HS256 and a shared secret:
MPV_JWT_HS_SECRET=
# Default token lifetime in seconds; 0 = no expiry ("permanent", warned).
MPV_JWT_DEFAULT_TTL=31536000
# In-memory revocation denylist cache TTL (seconds).
MPV_REVOCATION_CACHE_TTL=30

# --- Opaque tokens (when MPV_AUTH_MODE=opaque) -----------------------------
# Permanent opaque tokens use this prefix; only a SHA-256 hash is stored.
MPV_TOKEN_PREFIX=mpv_
# RFC 9728 discovery layer (RemoteAuthProvider) for the opaque path.
MPV_PUBLISH_DISCOVERY=true

# --- Model / validator behaviour ------------------------------------------
# Preload all ML models at startup (slower boot, no first-request latency spike).
# Set false to lazy-load each model on first use.
MPV_PRELOAD_MODELS=true
# Per-validator timeout (seconds). A slow/hung detector becomes a fail-safe finding.
MPV_VALIDATOR_TIMEOUT=8.0
# Fail mode when a validator errors/times out: "safe" (treat as HIGH finding) or
# "open" (treat as pass). "safe" is the secure default.
MPV_VALIDATOR_FAIL_MODE=safe

# How much of the verdict the CALLER is told. Every validator runs either way —
# this only shapes the response.
#   summary = pass -> {"passed": true, "status": "validation passed"}
#             fail -> failed categories + reasons + a rewrite suggestion each
#   full    = the complete Verdict (all findings, scores, severities)
# The full result is written to audit_logs regardless of this setting.
MPV_VALIDATION_RESPONSE_MODE=summary
# true  = a caller-supplied `categories` list is IGNORED; the whole policy always
#         runs (a client cannot silently skip checks).
# false = honour the caller's filter and validate only those categories.
MPV_ENFORCE_ALL_CATEGORIES=true

# Per-category ML model toggles. Set to false to skip a model ENTIRELY (no
# download/load attempt at all, ever) if you don't want the multi-GB
# downloads or don't need that category's ML-grade detection:
#   - injection: heuristic regex patterns still run regardless of this flag.
#   - toxicity: the lexical profanity gate still runs regardless of this flag.
#   - pii / banned_topics: have no non-ML mode, so disabling skips the
#     category's validator entirely.
MPV_ENABLE_INJECTION_MODEL=true
MPV_ENABLE_PII_MODEL=true
MPV_ENABLE_BANNED_TOPICS_MODEL=true
MPV_ENABLE_TOXICITY_MODEL=true

# Hugging Face model ids (override to swap detectors).
MPV_INJECTION_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
MPV_BANNED_TOPICS_MODEL=facebook/bart-large-mnli
MPV_TOXICITY_MODEL=original
# spaCy model used by Presidio.
MPV_SPACY_MODEL=en_core_web_lg

# Detection thresholds (0..1).
MPV_PII_THRESHOLD=0.5
MPV_INJECTION_THRESHOLD=0.8
MPV_BANNED_TOPICS_THRESHOLD=0.75
MPV_TOXICITY_THRESHOLD=0.6

# Length limits enforced by the schema validator.
MPV_MAX_CHARS=20000
MPV_MAX_TOKENS=6000
# tiktoken encoding used for token counting.
MPV_TIKTOKEN_ENCODING=cl100k_base

# Comma-separated banned topics for the zero-shot classifier.
MPV_BANNED_TOPICS=violence,self-harm,illegal weapons,malware,child sexual content

# Gated Hugging Face models (e.g. Llama Prompt Guard) need a token.
HF_TOKEN=

# --- Admin dashboard -------------------------------------------------------
MPV_DASHBOARD_ENABLED=true
MPV_DASHBOARD_PATH=/admin
# Secret for signing the dashboard session cookie. CHANGE THIS in production.
MPV_DASHBOARD_SECRET=change-me-in-production

# --- Logging ---------------------------------------------------------------
MPV_LOG_LEVEL=INFO
